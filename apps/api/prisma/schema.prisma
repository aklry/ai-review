generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
model CandidateProfile {
  id               String   @id @default(cuid())
  userKey          String   @default("local-user")
  displayName      String?
  resumeText       String
  structuredResume Json?
  resumeSource     String   @default("text")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  resumeDocument   ResumeDocument?
  jobs             Job[]
  stories          Story[]
  plans            InterviewPlan[]
}

model ResumeDocument {
  id              String    @id @default(cuid())
  profileId       String?   @unique
  userKey         String    @default("local-user")
  bucket          String
  objectKey       String    @unique
  originalName    String
  mimeType        String
  extension       String
  sizeBytes       Int
  sha256          String
  parseStatus     String    @default("pending")
  parseError      String?
  parserVersion   String    @default("resume-parser-v1")
  extractedChars  Int       @default(0)
  createdAt       DateTime  @default(now())
  parsedAt        DateTime?

  profile         CandidateProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([userKey, createdAt])
  @@index([userKey, sha256])
  @@index([parseStatus])
}

model Job {
  id              String            @id @default(cuid())
  profileId       String
  targetRole      String
  company         String?
  description     String
  analysis        Json?
  analysisStatus  String            @default("pending")
  analysisError   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  profile         CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plans           InterviewPlan[]

  @@index([profileId])
}

model Story {
  id        String   @id @default(cuid())
  profileId String
  title     String
  project   String
  situation String
  task      String
  action    String
  result    String
  metrics   String[]
  createdAt DateTime @default(now())

  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model InterviewPlan {
  id           String   @id @default(cuid())
  profileId    String
  jobId        String
  language     String
  round        String
  difficulty   String
  questionCount Int
  createdAt    DateTime @default(now())

  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sessions     InterviewSession[]

  @@index([profileId])
  @@index([jobId])
}

model InterviewSession {
  id                  String   @id @default(cuid())
  planId              String
  mode                String   @default("simulation")
  status              String   @default("active")
  currentQuestionIndex Int      @default(0)
  startedAt           DateTime @default(now())
  endedAt             DateTime?

  plan                InterviewPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  questions           InterviewQuestion[]
  answers             InterviewAnswer[]
  cues                CoachingCue[]
  report              EvaluationReport?
  usage               UsageLedger[]

  @@index([planId])
}

model InterviewQuestion {
  id         String   @id @default(cuid())
  sessionId  String
  order      Int
  competency String
  difficulty String
  prompt     String
  isCore     Boolean
  createdAt  DateTime @default(now())

  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer     InterviewAnswer?

  @@unique([sessionId, order])
  @@index([sessionId])
}

model InterviewAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId String   @unique
  answerText String
  createdAt  DateTime @default(now())

  session    InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  cue       CoachingCue?

  @@index([sessionId])
}

model CoachingCue {
  id               String   @id @default(cuid())
  sessionId        String
  answerId         String   @unique
  competency       String
  score            Int
  strengths        String[]
  gaps             String[]
  nextAction       String
  evidence         Json
  followUpQuestion String?
  createdAt        DateTime @default(now())

  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer            InterviewAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model EvaluationReport {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  summary          String
  overallScore     Float
  competencyScores Json
  strengths        String[]
  gaps             String[]
  nextPlan         Json
  createdAt        DateTime @default(now())

  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UsageLedger {
  id                String   @id @default(cuid())
  userKey           String
  sessionId         String?
  model             String
  taskType          String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cachedInputTokens Int      @default(0)
  degraded          Boolean  @default(false)
  estimatedCostCny   Float    @default(0)
  createdAt         DateTime @default(now())

  session            InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userKey, createdAt])
  @@index([sessionId])
}
