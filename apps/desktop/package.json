{
  "name": "@interview-assistant/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --win nsis",
    "dist:dir": "pnpm build && electron-builder --win --dir",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@interview-assistant/contracts": "workspace:*",
    "axios": "^1.8.4",
    "element-plus": "^2.9.7",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron-builder": "^26.18.0",
    "electron": "^35.0.0",
    "electron-vite": "^3.0.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.8"
  }
}
