NODE_ENV=development
API_PORT=3000
DESKTOP_ORIGIN=http://localhost:5173
# Optional origin of the installed Capacitor Android client
# MOBILE_ORIGIN=https://localhost
API_BASE_URL=http://localhost:3000/api

DATABASE_URL=postgresql://interview:interview_dev_only@localhost:5432/interview_assistant
# PostgreSQL checkpoint tables; the API role needs schema/table creation rights.
AGENT_CHECKPOINT_SCHEMA=public
# Optional: only set when running the isolated PostgreSQL integration suite.
# AGENT_INTEGRATION_DATABASE_URL=postgresql://user:password@localhost:5432/test_database
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=interview
S3_SECRET_KEY=interview_dev_only
S3_BUCKET=interview-assistant
# MINIO_* names are preferred for resume uploads; S3_* names remain supported.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=interview
MINIO_SECRET_KEY=interview_dev_only
MINIO_BUCKET_RESUMES=interview-resumes
MINIO_USE_SSL=false
RESUME_MAX_FILE_MB=10

# Never put production credentials in this file or in the Electron app.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRIMARY=deepseek-v4-pro
DEEPSEEK_MODEL_FALLBACK=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_API_KEY=
MODEL_MONTHLY_BUDGET_CNY=50
